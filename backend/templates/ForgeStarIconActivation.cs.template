[HarmonyPatch(typeof(NCard), "UpdateStarCostVisuals")]
internal static class ForgeStarIconBadgePatch
{
    private static Texture2D? _tex;
    internal static Texture2D? StarTex()
    {
        if (_tex != null) return _tex;
        const string path = "res://{{starIconPath}}";
        if (ResourceLoader.Exists(path)) _tex = ResourceLoader.Load<Texture2D>(path, null, ResourceLoader.CacheMode.Reuse);
        return _tex;
    }

    [HarmonyPostfix]
    private static void Postfix(NCard __instance)
    {
        try
        {
            if (__instance.Model is not IStarIconCard) return;
            var tex = StarTex();
            if (tex == null) return;
