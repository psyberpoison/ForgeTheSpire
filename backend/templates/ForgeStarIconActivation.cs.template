        }
        catch { }
    }
}

internal static class ForgeStarCounterIcon
{
    private static readonly HashSet<ulong> _foreign = new HashSet<ulong>();

    internal static void Apply(NStarCounter counter)
    {
        var icon = counter.GetNodeOrNull<TextureRect>("Icon");
        if (icon == null) return;
        var tex = ForgeStarIconBadgePatch.StarTex();
        if (tex == null || icon.Texture == tex) return;
        var id = counter.GetInstanceId();
        if (_foreign.Contains(id)) return;
        if (_foreign.Count > 64) _foreign.Clear();
        var player = Traverse.Create(counter).Field("_player").GetValue<Player>();
        if (player == null) return;
        if (player.Character is not global::{{namespace}}.Characters.{{characterClassName}})
        {
            _foreign.Add(id);
            return;
        }
        icon.Texture = tex;
        var layers = icon.GetNodeOrNull<Control>("RotationLayers");
        if (layers != null) layers.Visible = false;
    }
}

