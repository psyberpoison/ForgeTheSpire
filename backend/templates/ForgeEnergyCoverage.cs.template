// AUTO-GENERATED by Forge -- do not hand-edit, changes will be overwritten on next export.
//
// [Round 391] "Energy coverage" -- a card with Advanced Options -> Energy coverage can be played
// with too little energy: every missing point of energy is paid by exhausting (or discarding)
// one OTHER card from the hand, picked by the player.
//
// The game has no card-level hook for this, so it is three small Harmony patches (all signatures
// and orderings read directly from the installed sts2.dll IL):
//
//  1. PlayerCombatState.HasEnoughResourcesFor(CardModel, ref UnplayableReason) is what
//     CardModel.CanPlay asks "can this card be afforded?". Its only failure for a plain energy
//     shortfall is reason == EnergyCostTooHigh. The postfix flips that to playable when
//     energy + (number of OTHER cards in hand) >= the card's cost.
//  2. PlayCardAction.ExecuteAction calls CardModel.SpendResources() (SpendEnergy -> LoseEnergy,
//     which clamps at 0, so a too-high cost just empties the energy bar) and only AFTERWARDS
//     builds the GameActionPlayerChoiceContext it hands to CardModel.OnPlayWrapper. The prefix on
//     SpendResources therefore records how many points were NOT covered by energy (skipped when a
//     Hook.ShouldPayExcessEnergyCostWithStars relic/power pays the excess with stars instead).
//  3. The prefix on CardModel.OnPlayWrapper(choiceContext, target, isAutoPlay, resources,
//     skipCardPileVisuals) runs with that real choice context: it opens the game's own
//     CardSelectCmd.FromHand screen (exactly the prompt/selection the Exhaust or Discard effects
//     use), exhausts/discards the picked cards, then re-invokes the real OnPlayWrapper with the
//     original arguments (the recorded shortfall is cleared first, so the re-entrant call passes
//     straight through). The played card is still in the hand at that point, so it is filtered out
//     of the selection. Auto-plays (isAutoPlay) are never asked to pay.
public interface IForgeEnergyCoverage
{
    // true = covering cards are exhausted, false = discarded.
    bool ForgeCoverExhausts { get; }
}

internal static class ForgeEnergyCoverageState
{
    public static readonly ConditionalWeakTable<CardModel, StrongBox<int>> Shortfall = new ConditionalWeakTable<CardModel, StrongBox<int>>();
}

[HarmonyPatch(typeof(PlayerCombatState), nameof(PlayerCombatState.HasEnoughResourcesFor))]
internal static class ForgeEnergyCoverageAffordPatch
{
    [HarmonyPostfix]
    private static void Postfix(PlayerCombatState __instance, CardModel card, ref UnplayableReason reason, ref bool __result)
    {
        if (__result || !(card is IForgeEnergyCoverage)) return;
        if (reason != UnplayableReason.EnergyCostTooHigh) return; // only a pure energy shortfall can be covered
        var owner = card.Owner;
        if (owner == null) return;
        int cost = Math.Max(0, card.EnergyCost.GetWithModifiers(CostModifiers.All));
        int others = PileTypeExtensions.GetPile(PileType.Hand, owner).Cards.Count(c => c != card);
        if (__instance.Energy + others >= cost)
        {
            reason = UnplayableReason.None;
            __result = true;
        }
    }
}

[HarmonyPatch(typeof(CardModel), nameof(CardModel.SpendResources))]
internal static class ForgeEnergyCoverageSpendPatch
{
    [HarmonyPrefix]
    private static void Prefix(CardModel __instance)
    {
        if (!(__instance is IForgeEnergyCoverage)) return;
        var pcs = __instance.Owner?.PlayerCombatState;
        if (pcs == null) return;
        int shortfall = 0;
        // Same shortcut SpendResources itself takes: stars pay the excess, so energy is not short.
        bool starsPayExcess = __instance.CombatState != null
            && MegaCrit.Sts2.Core.Hooks.Hook.ShouldPayExcessEnergyCostWithStars(__instance.CombatState, __instance.Owner);
        if (!starsPayExcess)
        {
            shortfall = Math.Max(0, __instance.EnergyCost.GetAmountToSpend() - pcs.Energy);
        }
        ForgeEnergyCoverageState.Shortfall.Remove(__instance);
        ForgeEnergyCoverageState.Shortfall.Add(__instance, new StrongBox<int>(shortfall));
    }
}

[HarmonyPatch(typeof(CardModel), nameof(CardModel.OnPlayWrapper))]
internal static class ForgeEnergyCoveragePayPatch
{
    [HarmonyPrefix]
    private static bool Prefix(CardModel __instance, PlayerChoiceContext choiceContext, bool isAutoPlay, object[] __args, ref Task __result)
    {
        if (isAutoPlay || !(__instance is IForgeEnergyCoverage cover)) return true;
        if (!ForgeEnergyCoverageState.Shortfall.TryGetValue(__instance, out var box) || box.Value <= 0) return true;
        int shortfall = box.Value;
        box.Value = 0; // consumed: the re-entrant OnPlayWrapper call below passes straight through
        __result = PayThenPlay(__instance, choiceContext, cover.ForgeCoverExhausts, shortfall, __args);
        return false;
    }

    private static async Task PayThenPlay(CardModel card, PlayerChoiceContext choiceContext, bool exhausts, int shortfall, object[] originalArgs)
    {
        var owner = card.Owner;
        var candidates = PileTypeExtensions.GetPile(PileType.Hand, owner).Cards.Where(c => c != card).ToList();
        int count = Math.Min(shortfall, candidates.Count);
        if (count > 0)
        {
            var prompt = exhausts ? CardSelectorPrefs.ExhaustSelectionPrompt : CardSelectorPrefs.DiscardSelectionPrompt;
            var picked = (await CardSelectCmd.FromHand(choiceContext, owner, new CardSelectorPrefs(prompt, count), c => c != card, card)).ToList();
            foreach (var coveringCard in picked)
            {
                if (exhausts) await CardCmd.Exhaust(choiceContext, coveringCard, false, false);
                else await CardCmd.Discard(choiceContext, coveringCard);
            }
        }
        var original = typeof(CardModel).GetMethod(nameof(CardModel.OnPlayWrapper));
        await (Task)original.Invoke(card, originalArgs);
    }
}
