    // Round 94 — the last creature these bars were updated for, so a
    // hover handler (wired once at build time, with no creature of its
    // own to read) can look up live state at the instant the mouse
    // enters. Only ever the local player's own creature — see the header
    // comment above for why a single static field is safe here. Shared
    // across both anchors since there's still only ever one local player.
    private static Creature _lastCreature;

    // Round 94b — total pixel height of everything a given bar/diamond
    // list pair will draw (standalone bars stacked, then diamond-group
    // rows stacked below them — same layout math as BuildBars'/
    // BuildDiamondGroups' own `y` increments below, kept in sync with
    // those by hand since this runs before either has actually built
    // anything). Used by the energy-tied anchor
    // (ForgeResourceBarsEnergyAnchor.cs) to sit ABOVE the energy counter
    // instead of below it — it needs to know the total content height up
    // front to push the whole stack upward by that amount. The
    // health-tied anchor doesn't need this: it always anchors below,
    // growing away from the health bar, so no pre-measurement is needed
    // there.
    public static float GetTotalContentHeight(List<BarSpec> bars, List<DiamondSpec> diamonds)
    {
        var barsHeight = bars.Count * (BarHeight + BarGap);
        var diamondRowHeight = Mathf.Max(BarHeight, DiamondSize);
        var diamondsHeight = diamonds.Count * (diamondRowHeight + BarGap);
        return barsHeight + diamondsHeight;
    }

    // Builds the bar stack once as a child of `parent`, positioned via
    // `anchorOffset` (parent-local coordinates — the caller works out what
    // "above the energy counter"/"below the health bar" means in its own
    // node's geometry, see the two per-anchor patch files). No-ops if
    // already built (re-entrant _Ready/RefreshValues calls are real and
    // expected). `bars`/`containerName` let the same code build either the
    // Energy or the Health set (round 101).
    public static void BuildBars(Node parent, Vector2 anchorOffset, List<BarSpec> bars, string containerName)
    {
        if (bars.Count == 0) return;
        if (parent.HasNode(containerName)) return;

        var container = new Control { Name = containerName, Position = anchorOffset };
        parent.AddChild(container);

        var y = 0f;
        foreach (var bar in bars)
        {
            var row = new Control { Name = $"Bar_{bar.Key}", Position = new Vector2(0, y), Size = new Vector2(BarWidth, BarHeight) };
            // Round 94 — Stop so this row catches its own hover instead of
            // passing it through to whatever's underneath (the energy
            // counter / health bar it's anchored to).
            row.MouseFilter = Control.MouseFilterEnum.Stop;
            container.AddChild(row);

            var bg = new ColorRect { Name = "Bg", Color = new Color(0f, 0f, 0f, 0.55f), Size = new Vector2(BarWidth, BarHeight) };
            bg.MouseFilter = Control.MouseFilterEnum.Ignore;
            row.AddChild(bg);

            var fill = new ColorRect { Name = "Fill", Color = bar.Color, Size = new Vector2(0f, BarHeight) };
            fill.MouseFilter = Control.MouseFilterEnum.Ignore;
            row.AddChild(fill);

            var label = new Label { Name = "Label", Text = bar.Label, Position = new Vector2(2f, -1f) };
            label.MouseFilter = Control.MouseFilterEnum.Ignore;
            label.AddThemeFontSizeOverride("font_size", 10);
            row.AddChild(label);

            // Round 94 — wire hover once, at build time, same pattern as
            // ModStatusBars.cs's WireHover. Captures `bar`/`row` by
            // closure; reads `_lastCreature` fresh on every hover rather
            // than at build time, since the bound creature can change
            // (a new run, a new health bar instance) after these bars
            // are first built.
            var capturedBar = bar;
            var capturedRow = row;
            row.MouseEntered += () =>
            {
                var creature = _lastCreature;
                if (creature == null) return;
                var model = capturedBar.GetModel(creature);
                if (model == null) return;
                ShowNativeTooltip(capturedRow, model);
            };
            row.MouseExited += () => HideNativeTooltip(capturedRow);

            y += BarHeight + BarGap;
        }
    }

    // Updates every bar's fill width from `creature`'s real current power
    // stacks. `creature` may be null (e.g. the anchor node hasn't bound a
    // real Creature yet) — every bar just reads as empty in that case,
    // same "no data yet, don't crash" convention as every other
    // defensively-null-checked Forge codegen path.
    public static void UpdateBars(Node parent, Creature creature, List<BarSpec> bars, string containerName)
    {
        _lastCreature = creature; // Round 94 — kept fresh for hover lookups.
        if (bars.Count == 0) return;
        var container = parent.GetNodeOrNull<Control>(containerName);
        if (container == null) return;

        foreach (var bar in bars)
        {
            var row = container.GetNodeOrNull<Control>($"Bar_{bar.Key}");
            var fill = row?.GetNodeOrNull<ColorRect>("Fill");
            if (fill == null) continue;

            var amount = creature != null ? bar.GetAmount(creature) : 0;
            var pct = bar.Max > 0 ? Mathf.Clamp((float)amount / bar.Max, 0f, 1f) : 0f;
            fill.Size = new Vector2(BarWidth * pct, BarHeight);
        }
    }

    // Convenience used by both per-anchor patches: build-if-missing, then
    // refresh fills, in one call — avoids depending on exact node-ready
    // ordering (whether a node's own creature binding is already set by
    // the time _Ready fires is not confirmed either way for either anchor
    // type), since this just runs on every real update tick/refresh
    // instead. Round 101 — takes the specific bar/diamond lists +
    // container name so the same call shape works for either anchor;
    // ForgeResourceBarsEnergyAnchor.cs passes EnergyBars/EnergyDiamondGroups/
    // EnergyContainerName, ForgeResourceBarsHealthAnchor.cs passes the
    // Health* equivalents.
    public static void EnsureAndUpdateBars(Node parent, Vector2 anchorOffset, Creature creature, List<BarSpec> bars, List<DiamondSpec> diamonds, string containerName)
    {
        BuildBars(parent, anchorOffset, bars, containerName);
        UpdateBars(parent, creature, bars, containerName);
        BuildDiamondGroups(parent, anchorOffset, bars, diamonds, containerName);
        UpdateDiamondGroups(creature, diamonds, containerName);
    }

    // ---- Round 94: the "diamond" layout — two side bars flanking a
    // center diamond, sharing one combined widget. [BEST EFFORT, ADAPTED
    // FROM PROVEN CODE, NOT YET BUILD-TESTED] — the bar-drawing and
    // hover-tooltip mechanics reuse the exact same real, working pieces
    // as the standalone bars above (themselves ported from Tyler's own
    // live ModStatusBars.cs), but the specific geometry here is a NEW,
    // generalized layout (fixed track widths, no flanking status icons)
    // rather than a byte-for-byte copy of that one character's own
    // health-bar-width-driven, icon-flanked version — real technique,
    // new arrangement, not yet exercised through a real dotnet build.
    private const float DiamondTrackWidth = 50f;
    private const float DiamondSize = 14f;
    private const float DiamondGap = 4f;

    public sealed class DiamondSpec
    {
        public string Key = "";
        public Color LeftColor;
        public Color RightColor;
        public Color CenterColor;
        public bool HasCenter;
        public int LeftMax = 1;
        public int RightMax = 1;
        public int CenterMax = 1;
        public Func<Creature, int> GetLeftAmount = _ => 0;
        public Func<Creature, int> GetRightAmount = _ => 0;
        public Func<Creature, int> GetCenterAmount = _ => 0;
        public Func<Creature, PowerModel> GetLeftModel = _ => null;
        public Func<Creature, PowerModel> GetRightModel = _ => null;
        public Func<Creature, PowerModel> GetCenterModel = _ => null;
    }

    // Round 101 — same per-anchor split as EnergyBars/HealthBars above.
    // compiler.js's writeResourceBars() guarantees every entry within one
    // diamond group shares the same anchor (a group is one indivisible
    // on-screen widget, so it can't be split across two anchor points) —
    // see that function's own up-front anchor-consistency check.
    public static readonly List<DiamondSpec> EnergyDiamondGroups = new()
    {
{{energyDiamondSpecEntries}}
    };

    public static readonly List<DiamondSpec> HealthDiamondGroups = new()
    {
{{healthDiamondSpecEntries}}
    };

    private static void WireDiamondHover(Control target, Func<Creature, PowerModel> getModel)
    {
        target.MouseFilter = Control.MouseFilterEnum.Stop;
        target.MouseEntered += () =>
        {
            var creature = _lastCreature;
            if (creature == null) return;
            var model = getModel(creature);
            if (model == null) return;
            ShowNativeTooltip(target, model);
        };
        target.MouseExited += () => HideNativeTooltip(target);
    }

    public static void BuildDiamondGroups(Node parent, Vector2 anchorOffset, List<BarSpec> bars, List<DiamondSpec> diamonds, string containerName)
    {
        if (diamonds.Count == 0) return;
        var container = parent.GetNodeOrNull<Control>(containerName) ?? parent as Control;
        if (container == null) return;
        if (container.HasNode("ForgeDiamondGroups")) return;

        // Stack below the standalone bars (if any) so nothing overlaps.
        var startY = bars.Count * (BarHeight + BarGap);
        var wrap = new Control { Name = "ForgeDiamondGroups", Position = new Vector2(0, startY) };
        container.AddChild(wrap);

        var rowHeight = Mathf.Max(BarHeight, DiamondSize);
        var y = 0f;
        foreach (var d in diamonds)
        {
            // Round 101 — node name includes containerName so an
            // Energy-anchored and a Health-anchored diamond group can
            // never collide during FindDiamondRow's global scene-tree
            // scan even if a user happened to reuse the same group id
            // (shouldn't happen given the anchor-consistency check in
            // compiler.js, but this makes the scene-tree lookup itself
            // safe regardless).
            var row = new Control
            {
                Name = $"Diamond_{containerName}_{d.Key}",
                Position = new Vector2(0, y),
                Size = new Vector2(DiamondTrackWidth * 2 + DiamondSize + DiamondGap * 2, rowHeight),
            };
            wrap.AddChild(row);

            var x = 0f;

            var leftBg = new ColorRect { Name = "LeftBg", Position = new Vector2(x, (rowHeight - BarHeight) / 2f), Color = new Color(0f, 0f, 0f, 0.55f), Size = new Vector2(DiamondTrackWidth, BarHeight) };
            leftBg.MouseFilter = Control.MouseFilterEnum.Ignore;
            row.AddChild(leftBg);
            var leftFill = new ColorRect { Name = "LeftFill", Position = new Vector2(x, (rowHeight - BarHeight) / 2f), Color = d.LeftColor, Size = new Vector2(0f, BarHeight) };
            leftFill.MouseFilter = Control.MouseFilterEnum.Ignore;
            row.AddChild(leftFill);
            var leftHover = new Control { Name = "LeftHover", Position = new Vector2(x, (rowHeight - BarHeight) / 2f), Size = new Vector2(DiamondTrackWidth, BarHeight) };
            row.AddChild(leftHover);
            WireDiamondHover(leftHover, d.GetLeftModel);
            x += DiamondTrackWidth + DiamondGap;

            if (d.HasCenter)
            {
                var diamondPos = new Vector2(x, (rowHeight - DiamondSize) / 2f);
                var diamondWrap = new Control { Name = "Diamond", Position = diamondPos, Size = new Vector2(DiamondSize, DiamondSize) };
                row.AddChild(diamondWrap);
                var diamondFill = new ColorRect { Name = "Fill", Color = d.CenterColor, Size = new Vector2(DiamondSize, DiamondSize) };
                diamondFill.MouseFilter = Control.MouseFilterEnum.Ignore;
                diamondWrap.AddChild(diamondFill);
                // A square rotated 45° reads as a diamond — cheap and
                // dependency-free, same trick the standalone bars' plain
                // rectangles use for bars.
                diamondFill.PivotOffset = new Vector2(DiamondSize / 2f, DiamondSize / 2f);
                diamondFill.RotationDegrees = 45f;
                WireDiamondHover(diamondWrap, d.GetCenterModel);
            }
            x += DiamondSize + DiamondGap;

            var rightBg = new ColorRect { Name = "RightBg", Position = new Vector2(x, (rowHeight - BarHeight) / 2f), Color = new Color(0f, 0f, 0f, 0.55f), Size = new Vector2(DiamondTrackWidth, BarHeight) };
            rightBg.MouseFilter = Control.MouseFilterEnum.Ignore;
            row.AddChild(rightBg);
            var rightFill = new ColorRect { Name = "RightFill", Position = new Vector2(x, (rowHeight - BarHeight) / 2f), Color = d.RightColor, Size = new Vector2(0f, BarHeight) };
            rightFill.MouseFilter = Control.MouseFilterEnum.Ignore;
            row.AddChild(rightFill);
            var rightHover = new Control { Name = "RightHover", Position = new Vector2(x, (rowHeight - BarHeight) / 2f), Size = new Vector2(DiamondTrackWidth, BarHeight) };
            row.AddChild(rightHover);
            WireDiamondHover(rightHover, d.GetRightModel);

            y += rowHeight + BarGap;
        }
    }

    public static void UpdateDiamondGroups(Creature creature, List<DiamondSpec> diamonds, string containerName)
    {
        _lastCreature = creature;
        if (diamonds.Count == 0) return;

        foreach (var d in diamonds)
        {
            // Node lookups are re-resolved by name every update rather than
            // cached — same defensive style as UpdateBars above, cheap at
            // this scale (at most 3 bars/groups total per anchor per
            // character).
            var row = FindDiamondRow(containerName, d.Key);
            if (row == null) continue;

            var leftAmt = creature != null ? d.GetLeftAmount(creature) : 0;
            var leftPct = d.LeftMax > 0 ? Mathf.Clamp((float)leftAmt / d.LeftMax, 0f, 1f) : 0f;
            var leftFill = row.GetNodeOrNull<ColorRect>("LeftFill");
            if (leftFill != null)
            {
                var w = DiamondTrackWidth * leftPct;
                leftFill.Position = new Vector2(DiamondTrackWidth - w, leftFill.Position.Y);
                leftFill.Size = new Vector2(w, BarHeight);
            }

            var rightAmt = creature != null ? d.GetRightAmount(creature) : 0;
            var rightPct = d.RightMax > 0 ? Mathf.Clamp((float)rightAmt / d.RightMax, 0f, 1f) : 0f;
            var rightFill = row.GetNodeOrNull<ColorRect>("RightFill");
            if (rightFill != null) rightFill.Size = new Vector2(DiamondTrackWidth * rightPct, BarHeight);

            if (d.HasCenter)
            {
                var centerAmt = creature != null ? d.GetCenterAmount(creature) : 0;
                var centerPct = d.CenterMax > 0 ? Mathf.Clamp((float)centerAmt / d.CenterMax, 0f, 1f) : 0f;
                var diamondFill = row.GetNodeOrNull<Control>("Diamond")?.GetNodeOrNull<ColorRect>("Fill");
                if (diamondFill != null) diamondFill.Modulate = new Color(1f, 1f, 1f, Mathf.Lerp(0.25f, 1f, centerPct));
            }
        }
    }

    // Scans every live "Diamond_<containerName>_<key>" node in the scene
    // tree — there's only ever one such container alive at a time per
    // anchor (the local player's own HUD), so a full-tree scan from the
    // root is cheap and avoids needing to thread the container reference
    // through UpdateDiamondGroups's simpler creature-only signature (kept
    // simple since it's called every refresh tick from both anchor
    // patches).
    private static Control FindDiamondRow(string containerName, string key)
    {
        var root = ((SceneTree)Engine.GetMainLoop())?.Root;
        if (root == null) return null;
        return FindDiamondRowRecursive(root, $"Diamond_{containerName}_{key}");
    }

    private static Control FindDiamondRowRecursive(Node node, string nodeName)
    {
        if (node.Name == nodeName && node is Control c) return c;
        foreach (var child in node.GetChildren())
        {
            var found = FindDiamondRowRecursive(child, nodeName);
            if (found != null) return found;
        }
        return null;
    }

    // ---- Round 94: hover tooltip, ported directly from
    // TheBurdenedNewCharacter's own real, live ModStatusBars.cs (rounds
    // 27/28's NPower-proxy positioning fix, round 94's IsVisible-force
    // fix for hidden statuses) — see claude/round94-hidden-status-
    // tooltip-fix.md for the full evidence trail behind every piece below.

    private static bool _npowerApiResolved;
    private static Type _npowerType;
    private static System.Reflection.MethodInfo _npowerCreateMethod; // static NPower.Create(PowerModel)
    private static System.Reflection.MethodInfo _npowerOnHoveredMethod; // instance OnHovered()
    private static System.Reflection.MethodInfo _npowerOnUnhoveredMethod; // instance OnUnhovered()
    private static Control _currentTipTarget;
    private static Control _currentTipControl;

    private static Type FindType(string fullName)
    {
        foreach (var asm in AppDomain.CurrentDomain.GetAssemblies())
        {
            var t = asm.GetType(fullName, false);
            if (t != null) return t;
        }
        return null;
    }

    private static void ResolveNPowerApi()
    {
        if (_npowerApiResolved) return;
        _npowerApiResolved = true;
        try
        {
            _npowerType = FindType("MegaCrit.Sts2.Core.Nodes.Combat.NPower");
            if (_npowerType == null) return;

            const System.Reflection.BindingFlags flags =
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic |
                System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Static;

            foreach (var m in _npowerType.GetMethods(flags))
            {
                var ps = m.GetParameters();
                if (m.Name == "Create" && m.IsStatic && ps.Length == 1) _npowerCreateMethod = m;
                if (m.Name == "OnHovered" && !m.IsStatic && ps.Length == 0) _npowerOnHoveredMethod = m;
                if (m.Name == "OnUnhovered" && !m.IsStatic && ps.Length == 0) _npowerOnUnhoveredMethod = m;
            }
        }
        catch (Exception e) { GD.Print("ForgeResourceBarSupport: resolving NPower proxy API failed: " + e); }
    }

    // Round 94 fix (same as ModStatusBars.cs): a status with "Hide status
    // icon" checked compiles `IsVisibleInternal => false`, which the real
    // NPower.OnHovered() we borrow here checks before rendering any
    // tooltip content at all. Force PowerModel.IsVisible true only for
    // the exact model instance being hovered, only for the instant
    // OnHovered() runs — the icon/apply-flash/Artifact-immunity behavior
    // stays exactly as hidden as intended.
    private static PowerModel _forceVisibleModel;

    [HarmonyPatch(typeof(PowerModel), nameof(PowerModel.IsVisible), MethodType.Getter)]
    private static class ForceVisibleForTooltipPatch
    {
        [HarmonyPostfix]
        private static void Postfix(PowerModel __instance, ref bool __result)
        {
            if (!__result && __instance != null && ReferenceEquals(__instance, _forceVisibleModel)) __result = true;
        }
    }

    // Creates a real, invisible NPower for `model`, positions it exactly
    // over `target` (the bar row itself), and calls its own OnHovered()
    // so the game's real tooltip logic takes over entirely, including
    // positioning.
    private static void ShowNativeTooltip(Control target, PowerModel model)
    {
        if (target == null || !GodotObject.IsInstanceValid(target) || model == null) return;
        ResolveNPowerApi();
        if (_npowerType == null || _npowerCreateMethod == null || _npowerOnHoveredMethod == null) return;
        try
        {
            HideNativeTooltip(target);

            object proxy = _npowerCreateMethod.Invoke(null, new object[] { model });
            if (proxy is not Control proxyControl) return;

            proxyControl.Name = "ForgeResourceBarTooltipProxy";
            proxyControl.MouseFilter = Control.MouseFilterEnum.Ignore;
            proxyControl.Modulate = new Color(1f, 1f, 1f, 0f);
            proxyControl.SetPosition(Vector2.Zero);
            proxyControl.SetSize(target.Size);
            target.AddChild(proxyControl);

            _currentTipControl = proxyControl;
            _currentTipTarget = target;

            _forceVisibleModel = model;
            try { _npowerOnHoveredMethod.Invoke(proxy, null); }
            finally { _forceVisibleModel = null; }
        }
        catch (Exception e) { GD.Print("ForgeResourceBarSupport: ShowNativeTooltip (NPower proxy) failed: " + e); }
    }

    private static void HideNativeTooltip(Control target)
    {
        var proxy = _currentTipControl;
        _currentTipControl = null;
        _currentTipTarget = null;
        if (proxy == null || !GodotObject.IsInstanceValid(proxy)) return;
        try { if (_npowerOnUnhoveredMethod != null) _npowerOnUnhoveredMethod.Invoke(proxy, null); }
        catch { }
        try { proxy.QueueFree(); }
        catch { }
    }
}
