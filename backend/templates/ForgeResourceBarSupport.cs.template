public static class ForgeResourceBarSupport
{
    // Public (not private like round 92-94's single ContainerName) so both
    // per-anchor patch files can pass the exact same literal back into
    // EnsureAndUpdateBars without duplicating/typo-risking the string.
    public const string EnergyContainerName = "ForgeResourceBarsEnergy";
    public const string HealthContainerName = "ForgeResourceBarsHealth";
    private const float BarWidth = 120f;
    private const float BarHeight = 12f;
    private const float BarGap = 3f;

    public sealed class BarSpec
