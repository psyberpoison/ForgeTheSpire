//
// NMerchantCharacter._Ready() (confirmed via sts2.dll IL: Extends =
// Godot.Node2D, not Control) unconditionally wraps its first child in a
// Spine-only MegaSprite with zero fallback — this prefix runs BEFORE that
// original body, swapping out whatever placeholder child BaseLib's own
// scene auto-conversion left behind for a real SpineSprite built from
// Forge's generated atlas+skeleton pair (see compiler.js's writeCharacterArt
// "Shop sprite" section for where those files get written). A Harmony
// PREFIX (not postfix) is required here specifically because
// _Ready()'s own GetChild(0) call throws before any postfix could ever
// run — see TOOLCHAIN_FINDINGS.md "Round 40" for the full IL proof of why
// the earlier AddedNode<T,N>-based technique could never have worked for
// this type.
[HarmonyPatch(typeof(NMerchantCharacter), "_Ready")]
public static class ForgeShopSpriteAttach
{
    private const string LogPrefix = "[ForgeShopSpriteAttach]";
    private const string AtlasPath = "res://{{atlasResPath}}";
    private const string SkeletonPath = "res://{{skeletonResPath}}";

    // Target on-screen height in pixels — [BEST EFFORT default: 473,
    // the exact value spine-shop-test2's own round 45 fix used, matching
    // the real reference mod's (sethmcleod/sts2-the-alchemist) own tuned
    // shop constant for this same base game/scene] — editable per-character
    // via character.shopSpriteTransform.modelHeight (Forge UI: Shop sprite
    // -> "Modify position/size").
    private const float ModelHeight = {{modelHeight}}f;

    // Where the art's bottom-center lands relative to wherever the base
    // game itself places this character's Node2D root — [BEST EFFORT
    // default: (0, 0), the exact starting point spine-shop-test2's own
    // round 45 fix used] — editable per-character via
    // character.shopSpriteTransform.offsetX/offsetY.
    private static readonly Vector2 ArtBottomCenter = new({{offsetX}}f, {{offsetY}}f);

    // Fallback bounding box, used only if the loaded skeleton data doesn't
    // expose get_x/get_y/get_width/get_height for some reason — matches
    // the generated skeleton's own real header (see compiler.js) exactly,
    // so the fallback and the real read should normally agree anyway.
    private static readonly Rect2 FallbackBounds = new(-256f, -256f, 512f, 512f);

    [HarmonyPrefix]
    private static void Prefix(NMerchantCharacter __instance)
    {
        if (__instance.GetChildCount() == 0)
            return;

        var existing = __instance.GetChild(0);
        if (existing.GetClass() == "SpineSprite")
            return; // already a real SpineSprite (e.g. re-entrant _Ready) — nothing to do

        __instance.RemoveChild(existing);
        existing.QueueFree();

        var sprite = BuildSprite();
        __instance.AddChild(sprite);
        __instance.MoveChild(sprite, 0);
    }

    // Loading recipe + diagnostic checks — same structure/ordering as a
    // real, working, shipped mod (sethmcleod/sts2-the-alchemist's
    // SpineModel.Load()/ReadFailed()), already proven against these exact
    // Forge-generated file shapes via spine-shop-test2 (rounds 42–46).
    // Always returns a real SpineSprite node (never null) so
    // NMerchantCharacter._Ready()'s own type check keeps passing even on a
    // load failure — a failed load just means an empty, never-ready
    // SpineSprite instead of a populated one, with the real reason logged
    // instead of silently swallowed.
    private static Node2D BuildSprite()
    {
        var sprite = ClassDB.Instantiate("SpineSprite").As<Node2D>();
        sprite.Name = "SpineSprite";

        var atlas = ClassDB.Instantiate("SpineAtlasResource").As<Resource>();
        var skeletonFile = ClassDB.Instantiate("SpineSkeletonFileResource").As<Resource>();
        var data = ClassDB.Instantiate("SpineSkeletonDataResource").As<Resource>();
        if (atlas is null || skeletonFile is null || data is null)
        {
            GD.PushError($"{LogPrefix} Could not instantiate one of the Spine resource classes " +
                          "(SpineAtlasResource/SpineSkeletonFileResource/SpineSkeletonDataResource).");
            return sprite;
        }

        var atlasErr = (Error)atlas.Call("load_from_atlas_file", AtlasPath).AsInt64();
        if (atlasErr != Error.Ok)
        {
            GD.PushError($"{LogPrefix} load_from_atlas_file({AtlasPath}) failed: {atlasErr}");
            return sprite;
        }

        var skelErr = (Error)skeletonFile.Call("load_from_file", SkeletonPath).AsInt64();
        if (skelErr != Error.Ok)
        {
            GD.PushError($"{LogPrefix} load_from_file({SkeletonPath}) failed: {skelErr}");
            return sprite;
        }

        // The data resource reads the skeleton when it holds both halves,
        // thus the atlas goes first (same ordering as the real reference
        // mod).
        data.Set("atlas_res", atlas);
        data.Set("skeleton_file_res", skeletonFile);

        if (!data.Call("is_skeleton_data_loaded").AsBool())
        {
            GD.PushError($"{LogPrefix} is_skeleton_data_loaded() is false after assigning " +
                          $"atlas_res/skeleton_file_res — {SkeletonPath} did not parse against " +
                          $"{AtlasPath}.");
            return sprite;
        }

        GD.Print($"{LogPrefix} is_skeleton_data_loaded() == true — assigning skeleton_data_res.");
        sprite.Set("skeleton_data_res", data);

        // Scale + position, same formula as the real reference mod's own
        // AlchemistMerchant.Attach(Node) (fetched verbatim in
        // claude/round27-alchemist-shop-rest-sprite-findings.md).
        var box = Bounds(data);
        var scale = ModelHeight / box.Size.Y;
        sprite.Scale = new Vector2(scale, scale);

        var bottom = -box.Position.Y * scale;
        var middleX = (box.Position.X + box.Size.X / 2f) * scale;
        sprite.Position = ArtBottomCenter - new Vector2(middleX, bottom);

        GD.Print($"{LogPrefix} placed sprite: box={box} scale={scale} position={sprite.Position}");
        return sprite;
    }

    // Reimplementation (same method names/ordering, same fallback
    // convention) of the real reference mod's own SpineModel.Bounds() —
    // the box around the skeleton's setup pose, in skeleton units. Its y
    // is the bottom edge, and Spine's y grows upward (the opposite of
    // Godot's), which is exactly why BuildSprite() negates box.Position.Y
    // above instead of adding it.
    private static Rect2 Bounds(Resource data)
    {
        foreach (var method in new[] { "get_x", "get_y", "get_width", "get_height" })
        {
            if (!data.HasMethod(method))
            {
                GD.PushError($"{LogPrefix} skeleton data has no {method}() — using fallback bounds.");
                return FallbackBounds;
            }
        }

        var box = new Rect2(
            data.Call("get_x").AsSingle(), data.Call("get_y").AsSingle(),
            data.Call("get_width").AsSingle(), data.Call("get_height").AsSingle());

        if (box.Size.Y > 1f)
            return box;

        GD.PushError($"{LogPrefix} skeleton data reported a box of {box} — using fallback bounds.");
        return FallbackBounds;
    }
}
