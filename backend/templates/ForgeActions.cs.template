    public static Creature? PickRandomEnemy(IEnumerable<Creature> enemies)
    {
        var list = enemies as IList<Creature> ?? new List<Creature>(enemies);
        return list.Count == 0 ? null : list[_forgeRandom.Next(list.Count)];
    }

