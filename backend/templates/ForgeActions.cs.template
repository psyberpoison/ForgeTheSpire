    // PileType.Hand (=2, read straight off the enum's own real Constant-
    // table value), PileTypeExtensions.GetPile(PileType, Player)
    // (real/public/static), and CardPile.Cards (a real, public
    // IReadOnlyList<CardModel>) are all independently [VERIFIED] via a
    // direct sts2.dll read this round — so the indexing/Count below are
    // plain BCL operations on top of those 3 real facts, not additional
    // game-specific guesses. This generalizes Earthquake's exact
    // "leftmost" case (fromRight:false, position:1 reproduces it
    // precisely) to any edge/position, for compiler.js's
    // CardPositionInHand condition kind (Glow and Playability only —
    // see that case's own comment in compiler.js for why). Null-safe:
    // `Owner` is nullable (a canonical/un-owned model instance has no
    // owner) — matches the `Owner?.` convention resolveGlowSubjectExpr
    // already uses elsewhere in compiler.js for the same reason.
    public static bool IsCardAtHandPosition(CardModel card, bool fromRight, int position)
    {
        var owner = card.Owner;
        if (owner == null) return false;
        var cards = MegaCrit.Sts2.Core.Entities.Cards.PileTypeExtensions.GetPile(MegaCrit.Sts2.Core.Entities.Cards.PileType.Hand, owner).Cards;
        var idx = fromRight ? cards.Count - position : position - 1;
        return idx >= 0 && idx < cards.Count && cards[idx] == card;
    }

