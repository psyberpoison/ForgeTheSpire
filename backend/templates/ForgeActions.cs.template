    // edge/position semantics as IsCardAtHandPosition above, just
    // answering "was it there right before it left Hand" instead of "is
    // it there right now". `card` is nullable here (unlike
    // IsCardAtHandPosition) because the OnAnyCardPlayed call site passes
    // `cardPlay.Card as IForgeHandPosition` — always a real Forge card in
    // practice (every one implements the interface) but the cast itself
    // is nullable syntax, so this stays defensive rather than trusting
    // that.
    public static bool WasCardAtHandPositionOnRemoval(IForgeHandPosition card, bool fromRight, int position)
    {
        if (card == null || card.ForgeHandIndexOnRemoval < 0) return false;
        var idx = fromRight ? card.ForgeHandCountOnRemoval - position : position - 1;
        return idx == card.ForgeHandIndexOnRemoval;
    }

    // [Round 56, 2026-09-08] Shared by all three hand-position Harmony
    // prefixes (Generated/ForgeHandPositionTracker.cs on
    // CardModel.OnPlayWrapper, Generated/ForgeHandPositionDiscardTracker.cs
    // on CardCmd.DiscardAndDraw, Generated/ForgeHandPositionTurnEndTracker.cs
    // on CombatManager.DoTurnEndCards) — pulled out of
    // ForgeHandPositionTracker.cs's own Prefix (where it originally lived,
    // round 54) once a second and third capture point needed the exact
    // same per-card logic, rather than copy-pasting it three times.
    // `card` is nullable-tolerant on purpose (`as IForgeHandPosition`
    // fails silently to a no-op) since every real Forge card implements
    // the interface but a defensive caller shouldn't have to null-check
    // first.
    public static void CaptureHandPositionBeforeRemoval(CardModel card)
    {
        if (card is not IForgeHandPosition hp) return;
        var pile = card.Pile;
        if (pile == null || pile.Type != MegaCrit.Sts2.Core.Entities.Cards.PileType.Hand)
        {
            hp.ForgeHandIndexOnRemoval = -1;
            hp.ForgeHandCountOnRemoval = 0;
            return;
        }
        var cards = pile.Cards;
        hp.ForgeHandCountOnRemoval = cards.Count;
        hp.ForgeHandIndexOnRemoval = -1;
        for (int i = 0; i < cards.Count; i++)
        {
            if (cards[i] == card)
            {
                hp.ForgeHandIndexOnRemoval = i;
                break;
            }
        }
    }
}
