    // [VERIFIED via decompiling TheBurdenedNewCharacter.dll v3 —
    // Earthquake] Earthquake's real, compiled `IsPlayable` override
    // (round 52, 2026-09-08) does exactly:
    //   PileTypeExtensions.GetPile(PileType.Hand, Owner).Cards.FirstOrDefault() == this;
